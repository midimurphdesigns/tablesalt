# tablesalt routes every model call through Vercel AI Gateway. One key
# replaces provider keys. Create at: vercel.com/dashboard → AI Gateway
# → API Keys. Looks like vck_...
AI_GATEWAY_API_KEY=

# Upstash Redis — backs per-IP rate limiting + daily budget counter on
# /api/agent. Create a free Upstash database, copy the REST URL and
# token from the Upstash console. If both are unset the rate limiter
# fails open (every request allowed) — fine for local dev, NEVER ship
# this configuration to production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — override the model. Any model the Gateway supports works.
# Defaults to openai/gpt-4o-mini. Examples:
#   openai/gpt-4o-mini  (default — what the eval scoreboard measured)
#   anthropic/claude-haiku-4-5
#   openai/gpt-4o
TABLESALT_MODEL=openai/gpt-4o-mini

# Optional — daily request cap across ALL IPs. Defaults to 200.
TABLESALT_DAILY_REQUEST_CAP=200

# Optional — monthly request cap across ALL IPs. Defaults to 1500.
# At gpt-4o-mini pricing this caps tablesalt's monthly demo spend
# under $1/month — well under the Vercel AI Gateway $50 ceiling.
# Independent of Vercel billing; this is the code-level guard.
TABLESALT_MONTHLY_REQUEST_CAP=1500

# Optional — admin shared secret for POST /api/admin/reset-limits.
# Lets the owner wipe all rate-limit + monthly-cap counters in Upstash
# (per-IP, per-IP-eval, daily, monthly) without waiting for them to
# expire. The endpoint returns 404 if this env var is unset or the
# query param doesn't match — default-deny, can't be enumerated.
# Generate with: openssl rand -hex 24
TABLESALT_ADMIN_KEY=
