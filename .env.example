# tablesalt uses the Vercel AI Gateway. The gateway routes the requests
# to OpenAI / Anthropic and handles billing. In production set
# AI_GATEWAY_API_KEY in Vercel env vars. Local dev can fall back to a
# direct provider key for offline testing.
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Upstash Redis — backs per-IP rate limiting + daily budget counter on
# /api/agent. Create a free Upstash database, copy the REST URL and
# token from the Upstash console. If both are unset the rate limiter
# fails open (every request allowed) — fine for local dev, NEVER ship
# this configuration to production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — override the model used by the agent route. Defaults to
# OpenAI's gpt-4o-mini via the AI Gateway. Set to 'anthropic' to use
# Claude Haiku 4.5 instead.
TABLESALT_MODEL_PROVIDER=openai

# Optional — daily request cap across ALL IPs. Defaults to 200.
TABLESALT_DAILY_REQUEST_CAP=200
